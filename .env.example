# ========================================================
# UrbanSync - Environment Configuration Template
# ========================================================

# Server Port
PORT=3000

# MongoDB Connection String (Dedicated UrbanSync Cluster)
# Example: mongodb+srv://<username>:<password>@urbansync-cluster.mongodb.net/urbansync?retryWrites=true&w=majority
MONGODB_URI=

# Cryptographic & Session Secrets (Generate strong random keys)
JWT_SECRET=urbansync_jwt_secret_bokaro_2026_secure_key_change_in_production
SESSION_SECRET=urbansync_session_secret_bokaro_2026_secure_key_change_in_production

# Application Environment
NODE_ENV=development

# Cloudinary Media Storage (Optional / Dedicated account or namespace)
# Example: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=urbansync
